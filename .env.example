# MedSync Hospital System Configuration
PORT=3000
NODE_ENV=development

# Supabase Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Fortinet Firewall Captive Portal Configuration (for PowerBI sync script)
FORTINET_URL=https://10.0.17.4:1003
FORTINET_SSL_VERIFY=0
FORTINET_USER=your_fortinet_username
FORTINET_PASS=your_fortinet_password

# PowerBI Report Server Credentials
POWERBI_USER=your_powerbi_username
POWERBI_PASS=your_powerbi_password

# Optional: Authentication bypass for local development testing only
BYPASS_AUTH=false

# Green API WhatsApp Integration Configuration
GREEN_API_INSTANCE_ID=your_green_api_instance_id
GREEN_API_TOKEN=your_green_api_token
GREEN_API_GROUP_IDS=1203630xxxxxxxx@g.us
# Optional: override target WhatsApp group IDs for auto VIP discharge alerts (falls back to GREEN_API_GROUP_IDS)
GREEN_API_VIP_DISCHARGE_GROUP_IDS=
# Optional: Vercel production base URL for 100%-Vercel VIP admission & discharge WhatsApp relay
APP_URL=https://elite-occu.vercel.app
# Optional: set to 1 to log VIP discharge WhatsApp messages without sending
VIP_DISCHARGE_WHATSAPP_DRY_RUN=0

# Telegram Bot Integration Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional: secret token to verify webhook requests from Telegram
TELEGRAM_WEBHOOK_SECRET=your_optional_webhook_secret

