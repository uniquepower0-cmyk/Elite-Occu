# MedSync Hospital System Configuration
# No external OAuth required for local file mode.
GEMINI_API_KEY=""
APP_URL=""

# --- Vercel Firebase Admin Integration Configuration ---
# You can set these environment variables in your Vercel Dashboard to connect the deployed app to your Firestore database.
# Option A: Paste the contents of your config files directly as JSON strings:
FIREBASE_CONFIG='{"projectId": "...", "firestoreDatabaseId": "..."}'
FIREBASE_SERVICE_ACCOUNT='{"projectId": "...", "clientEmail": "...", "privateKey": "..."}'

# Option B: Use flat environment variables:
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_FIRESTORE_DATABASE_ID="(default)"

