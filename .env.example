# MedSync Hospital System Configuration
PORT=3000
NODE_ENV=development

# Supabase Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Fortinet VPN Configuration (for PowerBI sync script)
FORTINET_USER=your_fortinet_username
FORTINET_PASS=your_fortinet_password

# PowerBI Report Server Credentials
POWERBI_USER=your_powerbi_username
POWERBI_PASS=your_powerbi_password

# Optional: Authentication bypass for local development testing only
BYPASS_AUTH=false
